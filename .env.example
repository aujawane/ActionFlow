# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_APP_URL=http://localhost:3000

# Production examples (Vercel):
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# INTERNAL_APP_URL=https://your-app.vercel.app

# Optional explicit Recall webhook URL for documentation/ops.
# If unset, Parfait derives: ${NEXT_PUBLIC_APP_URL}/api/recall/webhook
# Production: https://your-app.vercel.app/api/recall/webhook
# Local (ngrok): https://<your-ngrok-domain>/api/recall/webhook
RECALL_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Supabase: explicit staging vs production selection (see lib/env.ts)
# ---------------------------------------------------------------------------
# Parfait resolves to exactly one Supabase project at a time, chosen ONLY by this variable --
# never by NODE_ENV (a Vercel Preview build sets NODE_ENV=production too, so a NODE_ENV-based
# default would risk Preview silently using the Production database). There is no implicit
# default: every environment (local, Preview, Production) must set this explicitly or the app
# fails fast at first Supabase use with a clear error.
#
#   Local development -> staging
#   Vercel Preview     -> staging (set explicitly in Preview's env vars -- never inherit Production)
#   Vercel Production   -> production (set explicitly in Production's env vars)
NEXT_PUBLIC_SUPABASE_ENV=staging

# --- Production Supabase project ---
# Required when NEXT_PUBLIC_SUPABASE_ENV=production. On Vercel, set these only in the Production
# environment scope (not Preview) so a preview build can never read them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staging Supabase project (parfait-staging) ---
# Required when NEXT_PUBLIC_SUPABASE_ENV=staging (the local-dev default). The URL/anon key are
# NEXT_PUBLIC_-prefixed for the same reason the production ones are: the anon key is meant to be
# browser-safe, and only a literal NEXT_PUBLIC_* reference can be inlined into the browser bundle.
# The service-role key is never public.
NEXT_PUBLIC_STAGING_SUPABASE_URL=
NEXT_PUBLIC_STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# --- Ops-only: cross-environment data migration scripts ---
# Used only by scripts/copy-meeting-to-staging.ts and scripts/diagnose-execution-candidates.ts to
# copy/diagnose a meeting from production into staging (see docs/copy-meeting.md). These are
# separate, server-only, manually-run CLI scripts -- unrelated to the app's own runtime Supabase
# selection above, and never read by the app itself. STAGING_SUPABASE_SERVICE_ROLE_KEY above is
# reused here; only the URL name below is script-specific (no anon key needed for admin scripts).
STAGING_SUPABASE_URL=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Per attempt; execution-intelligence makes at most two attempts per stage.
EXECUTION_INTELLIGENCE_TIMEOUT_MS=60000

RECALL_API_KEY=
RECALL_REGION=us-west-2
# Recall signs webhook requests (webhook-id/webhook-timestamp/webhook-signature headers, verified
# here with the svix package) with a "whsec_..." secret. WHICH secret depends on when your Recall
# workspace was created:
#   - Workspace created on/after 2025-12-15: Developers > API Keys & Secrets > Create Workspace
#     Secret in the Recall dashboard. One secret verifies all webhooks/websockets/callbacks.
#   - Legacy workspace created before 2025-12-15: the per-endpoint "Signing Secret" shown on this
#     specific webhook's page under the Recall dashboard's Webhooks section.
# Required for any publicly reachable deployment (production and Vercel Preview alike);
# verification is only skipped for genuine local development (no VERCEL_ENV, NODE_ENV !=
# "production").
RECALL_WEBHOOK_SECRET=

# Zoom Server-to-Server OAuth (no browser callback URL)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# Google OAuth (user-connected Google Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Production:
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/integrations/google/callback

# Optional legacy/global Google Meet refresh token used by meeting-providers fallback
GOOGLE_REFRESH_TOKEN=
